rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper: Verifica se o usuário logado é Admin
    function isAdmin() {
      return request.auth != null && get(/databases/$(database)/documents/ALUNOS/$(request.auth.uid)).data.role == 'admin';
    }

    // --- REGRAS DA VITRINE (LOJA) ---
    match /LOJA_PRODUTOS/{produtoId} {
      // Qualquer pessoa (mesmo sem login) pode ver a vitrine
      allow read: if true;
      // Apenas administradores logados podem criar, editar ou excluir produtos
      allow write: if isAdmin();
    }

    // --- REGRAS DE ALUNOS ---
    match /ALUNOS/{userId} {
      allow read: if request.auth != null; // Mestre precisa ler todos, aluno o seu
      allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
      
      match /historicoPagamentos/{docId} {
         allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
         allow write: if isAdmin();
         // Aluno NÃO pode adulterar as faturas (quem escreve é a Vercel/Admin)
      }
    }
    
    // --- REGRAS DE PAGAMENTOS ---
    match /PAGAMENTOS/{orderId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null; // Aluno pode gerar "Pendente" via Checkout InApp
      allow update, delete: if isAdmin(); 
      // Apenas a Vercel/Admin atualiza os status dos pagamentos. 
    }

    // --- REGRAS DE EVENTOS ---
    match /EVENTOS/{eventoId} {
      // Qualquer pessoa pode ver o calendário de eventos
      allow read: if true;
      // Apenas admins podem publicar ou alterar eventos
      allow write: if isAdmin();
    }

    // --- REGRAS DO TATAME VIRTUAL ---
    match /TATAME_VIRTUAL/{aulaId} {
      // Qualquer aluno pode assistir às aulas
      allow read: if request.auth != null;
      // Apenas admins podem publicar vídeos
      allow write: if isAdmin();

      // [NOVO] REGRAS DE COMENTÁRIOS
      match /COMENTARIOS/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        allow update, delete: if isAdmin();
      }
    }

    // --- REGRAS DE ALUNOS DESTAQUES ---
    match /ALUNOS_DESTAQUES/{destaqueId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    
    // --- REGRAS DE CONFIGURAÇÃO ---
    match /config/{document=**} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    
    // --- REGRAS DE MATRÍCULAS ---
    match /matriculas/{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == document || isAdmin());
    }

    // --- REGRAS DE MODALIDADES (HORÁRIOS/GRADE) ---
    match /MODALIDADES/{modalidadeId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /FREQUENCIA/{checkinId} {
      // Aluno pode ler apenas seus próprios check-ins (suporte a aluno_id, uid e user_id)
      allow read: if request.auth != null && (
        resource.data.aluno_id == request.auth.uid || 
        resource.data.uid == request.auth.uid || 
        resource.data.user_id == request.auth.uid || 
        isAdmin()
      );
      // Aluno pode criar sua própria solicitação de check-in
      allow create: if request.auth != null && (
        request.resource.data.aluno_id == request.auth.uid || 
        request.resource.data.uid == request.auth.uid || 
        request.resource.data.user_id == request.auth.uid || 
        isAdmin()
      );
      // Apenas Admins podem aprovar ou excluir
      allow update, delete: if isAdmin();
    }

    // --- REGRAS DE LOGS FINANCEIROS (Audit Trail) ---
    match /finance_logs/{logId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
  }
}
