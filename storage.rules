rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      // Qualquer usuário logado pode ler imagens
      allow read: if request.auth != null;
      // Apenas usuários logados podem fazer upload de suas próprias pastas ou admins
      allow write: if request.auth != null;
    }
  }
}
